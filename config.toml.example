# apicker configuration example
# Copy this file to ~/.config/apicker/config.toml to customize.

# Rebuild the file cache if it is older than this many seconds.
# Set to 0 to only rebuild on metadata/config/root changes.
cache_ttl_seconds = 3600

# Directory scanned for the file cache.
root_dir = "/home/your-user"

# Whether to use the default ignore list (.git, node_modules, target, etc.)
# Default: true
use_default_ignores = true

# Additional directories to ignore when scanning for files.
ignore_dirs = ["node_modules", "target"]

# Escape hatch for desktop launchers that are mislabeled upstream.
#
# Application visibility is decided by the XDG Desktop Entry specification:
# entries are hidden when Type != Application, Hidden=true, NoDisplay=true,
# TryExec names a missing command, or OnlyShowIn/NotShowIn excludes the active
# $XDG_CURRENT_DESKTOP. You should not need this list for normal use.
#
# Entries may be named by desktop-file ID (e.g. "firefox.desktop",
# "kde-kate.desktop"), by basename, or by basename without the .desktop suffix
# (e.g. "firefox"). Matching is case-insensitive.
desktop_exclude = ["example-url-handler.desktop"]


[[sources]]
name = "ssh"
icon = "network-server"
description = "SSH Connection Launcher"
# Extracts hosts from ~/.ssh/config and starts foot terminal running ssh
script = "awk '/^Host [^*]/ {print $2}' ~/.ssh/config 2>/dev/null || echo 'localhost'"
action = "foot -e ssh {item}"

[[sources]]
name = "bitwarden"
icon = "security-high"
description = "Bitwarden Passwords (wl-copy)"
# Lists vault names and copies the chosen password to Wayland clipboard
script = "bw list items 2>/dev/null | jq -r '.[] | .name' || echo 'Vault Locked'"
action = "bw get password \"{item}\" | wl-copy"
